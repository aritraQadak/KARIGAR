# =================================================================
# Karigar Platform - Environment Configuration Template
# =================================================================

# Database URL for Prisma (SQLite for local dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# JWT Secret for session signing
JWT_SECRET="karigar_secret_jwt_artisan_2026_key"

# Google OAuth Configuration
# Frontend (Vite) Client ID:
VITE_GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"

# Backend (Optional if verifying server-side audience):
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# Optional Server Port for standalone Node backend (defaults to 5000)
PORT=5000

# AI service only; never prefix these credentials with VITE_.
SIGHTENGINE_API_USER=""
SIGHTENGINE_API_SECRET=""
# Operator cache revision; bump when changing the detector deployment.
SIGHTENGINE_DETECTOR_VERSION="hosted-2026-09"
